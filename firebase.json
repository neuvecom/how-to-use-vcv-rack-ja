{
    "hosting": {
        "public": "firebase-redirect",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "redirects": [
            {
                "source": "/:path*",
                "destination": "https://neuve.com/how-to-use-vcv-rack-ja/:path",
                "type": 301
            }
        ]
    },
    "firestore": {
        "database": "(default)",
        "location": "asia-northeast1",
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    }
}
