---
// ヘッダー右側にログイン状態を表示する（Starlight の SocialIcons を置き換え）
// ログイン・マイページは全コース共通のポータル（neuve.com/learn/）にあり、<neuve-auth> がそこへ案内する
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<Default />
<neuve-auth class="auth-status"></neuve-auth>

<script is:inline type="module">
    // 旧データの移行: 以前は users/{uid}/progress/{lessonId} に保存していた完了記録を、
    // 全コース共通の users/{uid}/courses/vcv-rack/lessons/{lessonId} へ 1 回だけ移す
    import { collection, doc, getDocs, writeBatch } from 'https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js';
    import { db, onUser } from 'https://neuve.com/learn/kit/neuve-learn.js';

    onUser(async (user) => {
        if (!user) return;
        try {
            const legacy = await getDocs(collection(db, 'users', user.uid, 'progress'));
            if (legacy.empty) return;
            const batch = writeBatch(db);
            legacy.docs.forEach((d) => {
                batch.set(doc(db, 'users', user.uid, 'courses', 'vcv-rack', 'lessons', d.id), {
                    completedAt: d.data().completedAt,
                });
                batch.delete(d.ref);
            });
            await batch.commit();
        } catch (error) {
            console.error('旧進捗データの移行に失敗しました', error);
        }
    });
</script>

<style>
    .auth-status {
        display: inline-flex;
        font-size: var(--sl-text-sm);
        --neuve-auth-color: var(--sl-color-text-accent);
        --neuve-auth-hover: var(--sl-color-white);
    }
</style>
