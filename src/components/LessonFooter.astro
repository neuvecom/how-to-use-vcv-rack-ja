---
// レッスンページの末尾に「完了」ボタン、全ページの末尾に Ko-fi バナーを付ける（Starlight の Footer を置き換え）
// 完了ボタンは全コース共通キットの <neuve-lesson-done>。記録は端末をまたいで同期され、ポータルのマイページに反映される
import Default from '@astrojs/starlight/components/Footer.astro';
import KofiBanner from './KofiBanner.astro';
import { COURSE_ID, isLesson } from '../lib/courses';

const lessonId = Astro.locals.starlightRoute.id;
const showProgress = isLesson(lessonId);
---

{showProgress && <neuve-lesson-done class="lesson-progress" course={COURSE_ID} lesson={lessonId} />}
<KofiBanner />
<Default />

<style>
    .lesson-progress {
        margin-top: 3rem;
        --neuve-accent: var(--sl-color-accent);
        --neuve-on-accent: var(--sl-color-black);
        --neuve-border: var(--sl-color-gray-5);
    }
</style>
