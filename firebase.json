{
    "hosting": {
        "public": "dist",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "cleanUrls": true,
        "trailingSlash": true,
        "headers": [
            {
                "source": "/_astro/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            }
        ]
    },
    "firestore": {
        "database": "(default)",
        "location": "asia-northeast1",
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    }
}
